# Any OpenAI-compatible endpoint. Copy to .env and fill in.
# Leave LLM_API_KEY empty to run offline against the scripted stand-in scorer.

# --- Groq (default; production model IDs verified at console.groq.com/docs/models)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# --- Hugging Face Inference Providers
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_...
# LLM_MODEL=<provider-qualified model id>

# --- OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

LLM_TIMEOUT=45

# Optional second provider, used when the primary returns 429. Groq's free tier
# caps tokens per day per *organization*, so extra keys from the same account do
# not help -- a different provider does.
FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b

# Comma-separated; "*" is fine here since the API has no auth and no cookies.
CORS_ORIGINS=*

# Used only by eval/bench_models.py; falls back to LLM_API_KEY.
# BENCH_BASE_URL=https://api.groq.com/openai/v1
# BENCH_API_KEY=

# Optional. Leave both unset to use the in-memory store (correct for Render /
# local dev, a single long-running process). Set both to switch to Upstash
# Redis instead -- required on Vercel, where each request can land on a
# different, memory-isolated serverless instance. Free tier at upstash.com;
# use the REST URL/token from the database's dashboard, not the redis:// one.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
